/* Tema do J.A.R.V.I.S no terminal — segue o canvas "JARVIS TUI" aprovado.
   Cores só aqui, como variáveis (nada hardcoded no Python).
   Prefixo j- evita sobrescrever variáveis do tema do Textual ($panel...). */
$j-bg: #05080f;
$j-ocean: #1e6fd9;
$j-neon: #00e5ff;
$j-danger: #ff3b3b;
$j-danger-strong: #c81e1e;
$j-danger-soft: #ff6b6b;
$j-panel: #0b1220;
$j-footer: #101a2c;
$j-line: #1a2436;
$j-muted: #8593ab;
$j-text-soft: #c9d6ea;
$j-user: #6aa8ff;
$j-ink: #001018;
$j-white: #ffffff;
$j-badge-ink: #0b1f3f;
$j-neon-soft: #7ff2ff;
/* Orb pixel-art do Copilot */
$j-orb-core: #1e6fd9;
$j-orb-shade: #1553a8;
$j-orb-hl: #9fd0ff;
$j-orb-ring: #ffffff;
$j-orb-ring-dim: #22324a;
$j-orb-white-dim: #8fa3bf;
/* Estilo 16-bit (sprites, barras e selos) */
$j-ok: #4ade80;
$j-warn: #ffcb6b;
$j-deep: #0e7490;
$j-pale: #c9fbff;
$j-scanline: #2a0f14;
$j-contact: #8a6a1f;

/* Sprites pixel-art (frontend/sprites.py → PixelSprite) */
PixelSprite > .px--neon { color: $j-neon; }
PixelSprite > .px--ocean { color: $j-ocean; }
PixelSprite > .px--deep { color: $j-deep; }
PixelSprite > .px--pale { color: $j-pale; }
PixelSprite > .px--white { color: $j-white; }
PixelSprite > .px--danger { color: $j-danger; }
PixelSprite > .px--warn { color: $j-warn; }
PixelSprite > .px--ok { color: $j-ok; }
PixelSprite > .px--ink { color: $j-bg; }
PixelSprite > .px--muted { color: $j-muted; }

Screen {
    background: $j-bg;
    color: $j-text-soft;
}

/* --- Barra superior: marca · selo do modo · sessão · info --- */
#topbar {
    height: 1;
    background: $j-ocean;
    color: $j-white;
}

#brand {
    width: auto;
    padding: 0 2 0 1;
    text-style: bold;
}

#mode-badge {
    width: auto;
    padding: 0 1;
    background: $j-white;
    color: $j-badge-ink;
    text-style: bold;
}

#session-title {
    width: 1fr;
    padding: 0 2;
}

#topbar-info {
    width: auto;
    padding: 0 1;
}

/* --- Log de mensagens --- */
#log {
    padding: 0 2 0 1;
    scrollbar-size-vertical: 1;
    border-left: outer $j-ocean;
}

.msg {
    height: auto;
    margin: 1 0 0 0;
}

.msg-header { color: $j-muted; }
.msg.-user .msg-header { color: $j-user; text-style: bold; }
.msg.-assistant .msg-header { color: $j-neon; text-style: bold; }
.msg.-system .msg-header { color: $j-muted; }
.msg.-system .msg-body { color: $j-muted; }

.msg-body {
    height: auto;
    padding: 0 0 0 2;
    margin: 0;
}

Markdown.msg-body {
    background: transparent;
}

/* Títulos do Markdown: branco e negrito (sem o sublinhado azul padrão) */
.msg-body MarkdownH1, .msg-body MarkdownH2, .msg-body MarkdownH3 {
    color: $j-white;
    background: transparent;
    text-style: bold;
    content-align: left middle;
    margin: 1 0 0 0;
}

/* Bloco de código: filete ciano à esquerda + "┌─ linguagem" no topo */
CodeFence {
    background: $j-panel;
    border-left: outer $j-neon;
    border-top: solid $j-line;
    border-title-align: left;
    border-title-color: $j-muted;
}

CodeFence > Label { padding: 0 2; }

/* "[  OK  ]" das mensagens do sistema, em verde de boot */
.msg.-system MarkdownBlock > .code_inline {
    color: $j-ok;
    background: transparent;
    text-style: bold;
}

/* Selo de skill: LED + [INTENT] + [ OK ] / [ FAIL ] / [ ▚▚ ] */
MessageView > .msg--skill { color: $j-neon; text-style: bold; }
MessageView > .msg--ok { color: $j-ok; text-style: bold; }
MessageView > .msg--fail { color: $j-danger-soft; text-style: bold; }
MessageView > .msg--run { color: $j-warn; text-style: bold; }

/* Barras de bloco da linha de status: ciano (vermelho no crítico) */
StatusLine > .status--bar { color: $j-neon; }
Screen.-critical StatusLine > .status--bar,
ConfirmScreen StatusLine > .status--bar { color: $j-danger; }

/* --- Anexo pendente, input, status --- */
#attachbar {
    height: 1;
    background: $j-panel;
    color: $j-neon;
}

#prompt {
    margin: 0 1;
    border: double $j-ocean;
    background: $j-panel;
}

#prompt:focus { border: double $j-neon; }

/* Telemetria (esquerda) + atalhos (direita) numa linha só */
.statusbar {
    dock: bottom;
    height: 1;
    background: $j-panel;
    color: $j-muted;
}

.status-left { width: auto; padding: 0 1; }

.statusbar Footer {
    dock: none;
    width: 1fr;
    height: 1;
    background: $j-panel;
    align-horizontal: right;
}

.statusbar Footer FooterKey {
    background: $j-panel;
    color: $j-text-soft;
}

.statusbar Footer FooterKey .footer-key--key {
    background: $j-panel;
    color: $j-neon;
    text-style: bold;
}

/* --- Copilot: orb + boas-vindas e barra de voz (no lugar do input) --- */
#copilot-hero {
    height: auto;
    width: auto;
    margin: 1 0 0 2;
    padding: 0 2;
    border: double $j-neon;
    background: $j-panel;
}

#hero-text { width: auto; height: auto; padding: 0 0 0 3; }
#hero-title { color: $j-neon; }
#hero-info { color: $j-text-soft; }
#hero-state { color: $j-neon; }
#hero-hint { color: $j-muted; }

JarvisOrb > .orb--ring { color: $j-orb-ring; }
JarvisOrb > .orb--ring-dim { color: $j-orb-ring-dim; }
JarvisOrb > .orb--core { color: $j-orb-core; }
JarvisOrb > .orb--shade { color: $j-orb-shade; }
JarvisOrb > .orb--hl { color: $j-orb-hl; }
JarvisOrb > .orb--white { color: $j-orb-ring; }
JarvisOrb > .orb--white-dim { color: $j-orb-white-dim; }

#voicebar {
    height: 3;
    margin: 0 1;
    padding: 0 1;
    border: double $j-neon;
    background: $j-panel;
}

#voicebar Static { width: auto; padding: 0 1 0 0; }
#voice-mic { color: $j-neon; }
#voice-wave { color: $j-neon-soft; }
#voicebar #voice-text { width: 1fr; color: $j-text-soft; }
#voice-hint { color: $j-muted; }
#voice-vu { color: $j-neon; }

/* --- Modo Copilot: tudo puxa pro ciano neon --- */
Screen.-copilot #topbar { background: $j-neon; color: $j-ink; }
Screen.-copilot #mode-badge { background: $j-ink; color: $j-neon; }
Screen.-copilot #log { border-left: outer $j-neon; }
Screen.-copilot #prompt { border: double $j-neon; }

/* --- Protocolo crítico: vermelho sobrepõe qualquer modo --- */
Screen.-critical #topbar { background: $j-danger-strong; color: $j-white; }
Screen.-critical #topbar-info { text-style: bold; }
Screen.-critical #log { border-left: outer $j-danger; }
Screen.-critical #prompt { border: double $j-danger; }
Screen.-critical #voicebar { border: double $j-danger; }
Screen.-critical #voice-mic, Screen.-critical #voice-wave { color: $j-danger-soft; }

/* Linha de status do modal crítico: atalhos s/n em vermelho */
ConfirmScreen .statusbar Footer FooterKey .footer-key--key { color: $j-danger-soft; }

/* --- Modais (o fundo escurece a conversa) --- */
SessionPicker, ConfirmScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.55);
}

/* Protocolo crítico: o fundo escurece puxado para o vermelho.
   (hatch de scanline foi testado e "fura" a barra do topo: os espaços
   perdem o fundo vermelho — por isso um véu translúcido.) */
ConfirmScreen { background: $j-scanline 75%; }

.hint { color: $j-muted; }

#confirm {
    width: 64;
    max-width: 95%;
    height: auto;
    border: double $j-danger;
    background: $j-panel;
    padding: 1 2;
}

#confirm-head {
    height: auto;
    margin-bottom: 1;
}

#confirm-icon { margin-right: 2; }

#confirm-title {
    height: 6;
    content-align-vertical: middle;
    color: $j-danger-soft;
    text-style: bold;
}

#confirm-bar {
    margin-top: 1;
    color: $j-danger;
}

#confirm-expiry { margin: 1 0; }

#confirm-buttons {
    height: auto;
}

#confirm-buttons Button {
    margin-right: 2;
}

#confirm-yes {
    background: $j-danger-strong;
    color: $j-white;
    text-style: bold;
}

#confirm-no {
    background: $j-panel;
    color: $j-text-soft;
}

/* ===================== Telas cheias (/status, /skills, /log) ===================== */
JarvisScreen { background: $j-bg; }
JarvisScreen.-critical #topbar { background: $j-danger-strong; color: $j-white; }
JarvisScreen.-critical StatusLine > .status--bar { color: $j-danger; }

/* --- /status: 4 painéis (nome · valor, barras espaçadas, detalhe) + núcleo --- */
#status-body { height: 1fr; padding: 1 2; }

#status-grid {
    grid-size: 2 2;
    grid-gutter: 1 2;
    width: 1fr;
    height: 1fr;
}

.meter {
    border: round $j-line;
    background: $j-panel;
    padding: 1 2;
    height: 1fr;
}

.meter-head { height: 1; margin-bottom: 1; }
.meter-name { width: 1fr; color: $j-white; text-style: bold; }
.meter-value { width: auto; color: $j-neon; text-style: bold; }
.meter.-moderada .meter-value { color: $j-warn; }
.meter.-alta .meter-value { color: $j-danger-soft; }
BarChart > .chart--baixa { color: $j-neon; }
BarChart > .chart--moderada { color: $j-warn; }
BarChart > .chart--alta { color: $j-danger-soft; }
.meter-detail { height: 1; margin-top: 1; color: $j-muted; }

#status-side {
    width: 34;
    margin-left: 2;
    border: round $j-line;
    background: $j-panel;
    padding: 1 2;
}

#status-side Label { width: 1fr; }
#status-orb-box { height: auto; margin-top: 1; }
#status-level { margin: 1 0 2 0; text-style: bold; color: $j-neon; content-align: center middle; }
#status-level.-alta { color: $j-danger-soft; }
#status-procs-title { margin-bottom: 1; }
ProcessList > .procs--name { color: $j-white; }
ProcessList > .procs--size { color: $j-muted; }
#status-gap { height: 1fr; }

/* --- /skills: grid de cartuchos --- */
#skills-legend { height: 1; padding: 0 2; margin-top: 1; }
#skills-legend .legend { width: auto; margin-right: 3; color: $j-text-soft; }
#skills-legend .legend.-cat-automation { color: $j-neon; }
#skills-legend .legend.-cat-system { color: $j-warn; }

#skills-grid {
    grid-size: 4;
    grid-gutter: 1 2;
    grid-rows: 12;
    padding: 1 2;
    height: 1fr;
}

/* Cartucho retrô: aba · etiqueta (ícone + nome) · ■ categoria  ON · contatos */
.cartridge {
    width: 1fr;
    height: 11;
    min-width: 18;
    padding: 0 1;
    background: $j-panel;
    color: $j-white;
    border: round $j-line;
}
.cartridge:hover { background: $j-footer; }

.cart-tab { width: 1fr; height: 1; content-align: center top; color: $j-neon; }
.cart-label {
    height: 4;
    border: round $j-line;
    background: $j-bg;
}
.cart-icon { width: 1fr; content-align: center middle; color: $j-white; text-style: bold; }
.cart-name { width: 1fr; content-align: center middle; color: $j-white; text-style: bold; }
.cart-info { height: 1; margin-top: 1; }
.cart-dot { width: 2; color: $j-neon; }
.cart-cat { width: 1fr; color: $j-muted; }
.cart-state { width: auto; color: $j-neon; text-style: bold; }
.cart-gap { height: 1fr; }
.cart-contacts { width: 1fr; height: 1; color: $j-contact; }

.cartridge.-on { border: round $j-neon; }
.cartridge.-on.-cat-system { border: round $j-warn; }
.cartridge.-cat-system .cart-tab,
.cartridge.-cat-system .cart-dot,
.cartridge.-cat-system .cart-state { color: $j-warn; }

.cartridge.-off { offset-y: 1; background: $j-bg; border: round $j-line; }
.cartridge.-off .cart-tab,
.cartridge.-off .cart-dot,
.cartridge.-off .cart-contacts { color: $j-line; }
.cartridge.-off .cart-label { border: round $j-line; background: $j-bg; }
.cartridge.-off .cart-icon,
.cartridge.-off .cart-name,
.cartridge.-off .cart-cat,
.cartridge.-off .cart-state { color: $j-muted; text-style: none; }

.cartridge:focus { border: round $j-white; background: $j-footer; }

/* --- /log: filtros, timeline e linhas --- */
#log-filters { height: 3; padding: 0 2; margin-top: 1; }
.log-filter {
    min-width: 9;
    height: 3;
    margin-right: 1;
    padding: 0 1;
    background: $j-bg;
    color: $j-text-soft;
    border: round $j-line;
    text-style: none;
}
.log-filter:hover { background: $j-panel; }
.log-filter:focus { text-style: bold; }
.log-filter.-active { background: $j-neon; color: $j-bg; border: round $j-neon; text-style: bold; }

#log-timeline {
    height: auto;
    margin: 1 2 0 2;
    padding: 1 2;
    border: round $j-line;
    background: $j-panel;
}

#timeline-title { margin-bottom: 1; }
#timeline-steps { height: 3; }
#timeline-steps Label { width: auto; height: 3; content-align: center middle; }
#timeline-steps .step { padding: 0 2; background: $j-badge-ink; color: $j-white; text-style: bold; }
#timeline-steps .step.-ok { background: $j-ok; color: $j-bg; }
#timeline-steps .step.-fail { background: $j-danger-strong; color: $j-white; }
#timeline-steps .step.-run { background: $j-panel; color: $j-neon; text-style: bold italic; }
#timeline-steps .step.-speech { padding: 0 1; background: $j-panel; color: $j-neon; border: dashed $j-neon; }
#timeline-steps .wire { color: $j-neon; }

#log-search { margin: 1 2 0 2; border: tall $j-neon; background: $j-panel; }
#log-scroll { margin: 1 2; height: 1fr; scrollbar-size-vertical: 1; }

LogLines > .log--time { color: $j-muted; }
LogLines > .log--module { color: $j-user; }
LogLines > .log--old { color: $j-muted; }
LogLines > .log--mid { color: $j-text-soft; }
LogLines > .log--new { color: $j-white; }
LogLines > .log--DEBUG { color: $j-muted; text-style: bold; }
LogLines > .log--INFO { color: $j-neon; text-style: bold; }
LogLines > .log--WARN { color: $j-warn; text-style: bold; }
LogLines > .log--ERROR { color: $j-danger-soft; text-style: bold; }
LogLines > .log--CRITICAL { color: $j-danger; text-style: bold reverse; }
LogLines > .log--error-row { background: $j-scanline; }

/* --- Save slots (SessionPicker, Ctrl+O): grade 2 colunas de cartões --- */
#slots-scroll { height: 1fr; padding: 1 2 0 2; scrollbar-size-vertical: 1; }

#slots-grid {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 8;
    height: auto;
}

.slot {
    height: 8;
    padding: 0 1;
    border: round $j-line;
    background: $j-panel;
}
.slot:hover { background: $j-footer; }
.slot:focus { border: round $j-neon; background: $j-footer; }

.slot-head { height: 1; }
.slot-badge { width: auto; padding: 0 1; margin-right: 1; background: $j-badge-ink; color: $j-white; text-style: bold; }
.slot:focus .slot-badge { background: $j-neon; color: $j-ink; }
.slot-title { width: 1fr; color: $j-white; text-style: bold; text-wrap: nowrap; text-overflow: ellipsis; }
.slot-star { width: auto; color: $j-warn; }
.slot-meta { width: 1fr; color: $j-muted; text-wrap: nowrap; text-overflow: ellipsis; }
.slot-quote { width: 1fr; height: 1; margin-top: 1; color: $j-text-soft; }
.slot-bar { width: 1fr; height: 1; margin-top: 1; color: $j-ocean; }
.slot:focus .slot-bar { color: $j-neon; }
SlotBar > .slot-bar--empty { color: $j-line; }

#slots-search { height: 3; padding: 0 2; }
#slots-search-label { width: auto; height: 3; content-align-vertical: middle; margin-right: 1; color: $j-muted; }
#slots-filter { width: 1fr; border: tall $j-line; background: $j-panel; }
#slots-filter:focus { border: tall $j-neon; }

/* --- /vault: busca + árvore + prévia + radar --- */
#vault-search {
    height: 3;
    margin: 1 2 0 2;
    border: double $j-neon;
    background: $j-panel;
}
#vault-search-label { width: auto; color: $j-neon; text-style: bold; padding: 0 1; }
#vault-q { width: 1fr; border: none; background: $j-panel; height: 1; padding: 0; }
#vault-count { width: auto; padding: 0 1; }

#vault-body { height: 1fr; padding: 1 2; }
#vault-tree {
    width: 36;
    border: double $j-line;
    background: $j-panel;
    margin-right: 2;
}
#vault-preview {
    width: 1fr;
    border: double $j-line;
    background: $j-panel;
    padding: 0 1;
}
#vault-path { color: $j-muted; }
#vault-md { height: 1fr; background: transparent; }
#vault-actions { height: 3; }
#vault-use { background: $j-panel; color: $j-neon; border: tall $j-neon; }
#vault-use:disabled { color: $j-muted; border: tall $j-line; }

#vault-radar {
    width: 28;
    margin-left: 2;
    border: double $j-line;
    background: $j-panel;
    padding: 0 1;
    align-horizontal: center;
}
#radar { margin: 1 0; width: auto; }
#radar-state { color: $j-neon; }
#vault-results { height: 1fr; border: none; background: $j-panel; }

/* --- /config: menu RPG --- */
#cfg-body { height: 1fr; padding: 1 2; }
#cfg-menu-box {
    width: 28;
    border: double $j-neon;
    background: $j-panel;
    padding: 1 1;
    margin-right: 2;
}
#cfg-menu-title { padding-left: 2; }
#cfg-menu { border: none; background: $j-panel; height: auto; }
#cfg-main { width: 1fr; }
#cfg-panel {
    height: 1fr;
    border: double $j-neon;
    background: $j-panel;
    padding: 1 2;
}
#cfg-group { color: $j-white; text-style: bold; margin-bottom: 1; }
#cfg-options { border: none; background: $j-panel; height: auto; }
#cfg-info { color: $j-text-soft; margin-top: 1; }
#cfg-dialog {
    height: auto;
    margin-top: 1;
    border: double $j-neon;
    background: $j-panel;
    padding: 1 2;
}
#cfg-face { margin-right: 2; }
#cfg-dialog-text { height: auto; }
#cfg-speaker { color: $j-neon; text-style: bold; }

/* --- Boot / splash --- */
BootScreen { background: $j-bg; }
#boot { padding: 1 3; }
#boot-head { height: 1; }
#boot-bios { width: 1fr; color: $j-muted; }
#boot-logo-row { height: auto; margin: 1 0; }
#boot-logo { width: auto; color: $j-neon; text-style: bold; margin-right: 4; }
#boot-ident { height: auto; padding-top: 1; }
#boot-tagline { color: $j-text-soft; }
#boot-checks {
    height: auto;
    border: double $j-line;
    background: $j-panel;
    padding: 0 2;
}
.boot-row { height: 1; }
.boot-tag { width: 10; text-style: bold; color: $j-neon; }
.boot-tag.-ok { color: $j-ok; }
.boot-tag.-warn { color: $j-warn; }
.boot-tag.-fail { color: $j-danger-soft; }
.boot-step { width: 24; color: $j-text-soft; }
.boot-detail { width: 1fr; color: $j-muted; }
#boot-progress-head { height: 1; margin-top: 1; }
#boot-progress-label { width: 1fr; }
#boot-pct { width: auto; color: $j-neon; }
#boot-bar { color: $j-neon; }
#boot-final { margin-top: 1; color: $j-white; }

/* --- Shutdown CRT --- */
ShutdownScreen { background: black; align: center middle; }
#shutdown-lines { width: auto; height: auto; }
.shutdown-line { color: $j-text-soft; }
.shutdown-line.-ok { color: $j-text-soft; }
#shutdown-bye { color: $j-neon; text-style: bold; margin-top: 1; }
#crt { width: 1fr; height: 1fr; color: $j-pale; background: black; }

/* --- Easter egg: House Party Protocol --- */
HousePartyScreen { background: $j-bg; align: center middle; }
#party { width: auto; height: auto; align-horizontal: center; }
#party-title { color: $j-warn; text-style: bold; width: auto; }
#party-count { width: auto; margin-bottom: 1; }
#party-suits { height: auto; width: auto; }
.party-suit { width: 12; height: auto; align-horizontal: center; }
.party-id { color: $j-muted; width: auto; }
#party-quip {
    margin-top: 1;
    border: double $j-line;
    background: $j-panel;
    padding: 0 1;
    width: auto;
}
