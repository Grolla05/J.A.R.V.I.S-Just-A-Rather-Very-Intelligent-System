# Copie este arquivo para ".env" na raiz do projeto e preencha os valores.
# Nunca commite o arquivo ".env" real — veja SECURITY.md.

# --- Geral ---
LOG_LEVEL=INFO
DEBUG_MODE=False

# --- Ollama (LLM local) ---
# Modelo e host do servidor Ollama rodando localmente.
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434
# -1 = modelo nunca descarrega da VRAM. Também aceita duração, ex: "30m".
OLLAMA_KEEP_ALIVE=-1
# Sobe "ollama serve" no boot se o servidor local estiver offline.
OLLAMA_AUTOSTART=True
# Segundos esperando a API do Ollama responder após iniciar o servidor.
OLLAMA_START_TIMEOUT=30
# Segundos esperando o classificador de intenção e as decisões das skills (Ollama).
TIMEOUT_LLM=30
# Segundos das requisições HTTP (GitHub, notícias, web, YouTube).
TIMEOUT_API=10
# Janela de contexto (vazio = padrão do Ollama). Menor = KV cache menor = cabe mais na VRAM.
OLLAMA_NUM_CTX=
# Camadas na GPU (99 = todas; vazio = Ollama decide). Se recusar por falta de VRAM, é desativado sozinho.
OLLAMA_NUM_GPU=
# Modelo de visão para imagem anexada (/attach), tempo dele na VRAM e prazo da resposta.
OLLAMA_VISION_MODEL=moondream
OLLAMA_VISION_KEEP_ALIVE=5m
TIMEOUT_VISION=60

# --- Leitura de Tela (skill SCREEN_READ: OCR do Windows + modelo de texto) ---
# Idioma do OCR (tag BCP-47, ex.: pt-BR, en-US). Vazio = pt-BR → en-US → idiomas do Windows.
OCR_LANGUAGE=
# Máximo de caracteres lidos da tela enviados ao modelo (cabe no OLLAMA_NUM_CTX 4096).
SCREEN_TEXT_MAX=6000

# --- Áudio anexado (Whisper local) e uploads ---
WHISPER_MODEL_SIZE=base
# cpu | cuda | auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
TIMEOUT_TRANSCRIPTION=60
# Tamanho máximo de um anexo (MB)
MAX_UPLOAD_SIZE_MB=15

# --- Obsidian (memória de longo prazo via Local REST API) ---
OBSIDIAN_HOST=http://127.0.0.1:27123
OBSIDIAN_API_KEY=
# Score mínimo da busca no vault para a nota entrar no chat (vazio = sem corte)
VAULT_MIN_SCORE=

# --- Spotify (Web API — OAuth PKCE, sem client_secret) ---
# CHAVE PESSOAL: crie o SEU app em developer.spotify.com/dashboard
# (passo a passo em docs/integracoes-oauth.md).
# ATENÇÃO: o Spotify exige o IP literal no redirect URI cadastrado no
# dashboard — "localhost" é rejeitado. O valor abaixo precisa ser
# idêntico, byte a byte, ao registrado em developer.spotify.com/dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_MARKET=BR

# --- GitHub (skill GITHUB e /gh) ---
# Token pessoal (github.com/settings/tokens): fine-grained com leitura de
# Pull requests/Issues/Actions/Contents e escrita em Issues. Vazio = desligado.
GITHUB_TOKEN=
# Repositório usado quando o pedido não cita um (formato dono/repo).
GITHUB_DEFAULT_REPO=

# --- Google Agenda e Gmail (/config → INTEGRAÇÕES) ---
# CHAVES PESSOAIS: crie o SEU client OAuth "App para computador" no Google Cloud
# (Calendar API e Gmail API ativadas, app publicado "Em produção" — senão o login expira em 7 dias).
# Passo a passo em docs/integracoes-oauth.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Caracteres do corpo do e-mail enviados ao modelo (ler/resumir/responder)
EMAIL_TEXT_MAX=6000

# --- Ponte Telegram / Discord (/config → INTEGRAÇÕES) ---
# Converse com o JARVIS pelo celular: o cérebro roda NESTE computador, a plataforma é só o fio.
# Tokens dos SEUS bots (Telegram: @BotFather · Discord: Developer Portal, com "Message Content Intent").
# ALLOWED_IDS = quem pode conversar (vírgula separa). Vazio = ninguém. Mande /id ao bot para ver o seu.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_IDS=

# --- Trânsito no briefing (/rota casa|trabalho <endereço>) ---
# Vazio = OSRM (tempo estimado, grátis). Chave TomTom (developer.tomtom.com) = trânsito ao vivo.
TOMTOM_API_KEY=

# --- Consumo de energia (/status, linha de status, skill POWER_REPORT) ---
# Desktop não tem sensor do total: GPU NVIDIA medida (nvidia-smi) + CPU e resto estimados.
POWER_TARIFF_KWH=0.85   # R$/kWh da sua conta de luz
POWER_BASE_W=45         # placa-mãe, RAM, discos e ventoinhas
POWER_CPU_TDP_W=65      # TDP do processador (consumo a 100 %)
POWER_PSU_EFF=0.85      # eficiência da fonte (80 Plus Bronze ~0,85)

# --- Áudio (Listen / Speak) ---
SPEECH_RATE=180
MIC_INDEX=0
MIC_ENERGY_THRESHOLD=300
# Palavras que acordam o Copilot por voz, separadas por vírgula (vazio = padrão).
# Inclua variações que o reconhecimento de voz costuma ouvir no lugar do nome.
WAKE_WORDS=jarvis,jar,jair,javis,davis,gervis,jarbas,garvis,jefferson,jorge,jair vis

# --- Chat ---
# Turnos (pergunta + resposta) do histórico da sessão enviados ao modelo.
CHAT_HISTORY_TURNS=10

# --- Pomodoro / Não Perturbe (/focus, /dnd e "jarvis, inicia um pomodoro") ---
# Minutos de foco, pausa curta e pausa longa; ciclos de foco até a pausa longa.
POMODORO_FOCUS_MIN=25
POMODORO_SHORT_BREAK_MIN=5
POMODORO_LONG_BREAK_MIN=15
POMODORO_CYCLES=4

# --- Agente residente: atalhos globais (vazio desliga cada um) ---
# Abre/foca o JARVIS no Copilot
GLOBAL_HOTKEY=win+j
# Traduz o texto selecionado em qualquer app (toast + clipboard)
TRANSLATE_HOTKEY=ctrl+alt+t
# Selecione um código ou erro em qualquer app e o JARVIS explica no Chat
EXPLAIN_HOTKEY=ctrl+alt+e

# --- Atualização automática (só no app instalado) ---
# Ao abrir a TUI e no logon, compara a versão instalada com o último Release do GitHub.
# Com versão nova, a tela ATUALIZAÇÃO DISPONÍVEL pergunta; no Enter baixa o JARVIS-Setup.exe,
# confere o SHA-256 e a assinatura Minisign (sem assinatura válida não roda) e instala em silêncio.
# O toggle em /config -> SISTEMA vence este padrão.
AUTO_UPDATE=True
# Repositório dos Releases (dono/nome). Vazio = repositório oficial.
UPDATE_REPO=
