# Copie este arquivo para ".env" na raiz do projeto e preencha os valores.
# Nunca commite o arquivo ".env" real — veja SECURITY.md.

# --- Geral ---
LOG_LEVEL=INFO
DEBUG_MODE=False

# --- Ollama (LLM local) ---
# Modelo e host do servidor Ollama rodando localmente.
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434
# -1 = modelo nunca descarrega da VRAM. Também aceita duração, ex: "30m".
OLLAMA_KEEP_ALIVE=-1

# --- Obsidian (memória de longo prazo via Local REST API / MCP) ---
OBSIDIAN_HOST=http://127.0.0.1:27123
OBSIDIAN_API_KEY=

# --- Spotify (Web API — OAuth PKCE, sem client_secret) ---
# ATENÇÃO: o Spotify exige o IP literal no redirect URI cadastrado no
# dashboard — "localhost" é rejeitado. O valor abaixo precisa ser
# idêntico, byte a byte, ao registrado em developer.spotify.com/dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_MARKET=BR

# --- Áudio (Listen / Speak) ---
SPEECH_RATE=180
MIC_INDEX=0
MIC_ENERGY_THRESHOLD=300
