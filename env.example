# Copie este arquivo para ".env" na raiz do projeto e preencha os valores.
# Nunca commite o arquivo ".env" real — veja SECURITY.md.

# --- Geral ---
LOG_LEVEL=INFO
DEBUG_MODE=False

# --- Ollama (LLM local) ---
# Modelo e host do servidor Ollama rodando localmente.
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434
# -1 = modelo nunca descarrega da VRAM. Também aceita duração, ex: "30m".
OLLAMA_KEEP_ALIVE=-1
# Sobe "ollama serve" no boot se o servidor local estiver offline.
OLLAMA_AUTOSTART=True
# Segundos esperando a API do Ollama responder após iniciar o servidor.
OLLAMA_START_TIMEOUT=30

# --- Obsidian (memória de longo prazo via Local REST API / MCP) ---
OBSIDIAN_HOST=http://127.0.0.1:27123
OBSIDIAN_API_KEY=

# --- Spotify (Web API — OAuth PKCE, sem client_secret) ---
# ATENÇÃO: o Spotify exige o IP literal no redirect URI cadastrado no
# dashboard — "localhost" é rejeitado. O valor abaixo precisa ser
# idêntico, byte a byte, ao registrado em developer.spotify.com/dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_MARKET=BR

# --- GitHub (skill GITHUB e /gh) ---
# Token pessoal (github.com/settings/tokens): fine-grained com leitura de
# Pull requests/Issues/Actions/Contents e escrita em Issues. Vazio = desligado.
GITHUB_TOKEN=
# Repositório usado quando o pedido não cita um (formato dono/repo).
GITHUB_DEFAULT_REPO=

# --- Briefing diário ---
# Pastas para "arquivos mexidos nas últimas 24 h", separadas por ';'.
# Vazio = Desktop, Documentos e Downloads do usuário.
BRIEFING_DIRS=

# --- Áudio (Listen / Speak) ---
SPEECH_RATE=180
MIC_INDEX=0
MIC_ENERGY_THRESHOLD=300
# Palavras que acordam o Copilot por voz, separadas por vírgula (vazio = padrão).
# Inclua variações que o reconhecimento de voz costuma ouvir no lugar do nome.
WAKE_WORDS=jarvis,jar,jair,javis,davis,gervis,jarbas,garvis,jefferson,jorge,jair vis

# --- Pomodoro / Não Perturbe (/focus, /dnd e "jarvis, inicia um pomodoro") ---
# Minutos de foco, pausa curta e pausa longa; ciclos de foco até a pausa longa.
POMODORO_FOCUS_MIN=25
POMODORO_SHORT_BREAK_MIN=5
POMODORO_LONG_BREAK_MIN=15
POMODORO_CYCLES=4
